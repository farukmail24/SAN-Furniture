# ==============================================================================
# SAN Furniture (UK) – Environment Configuration Reference
# ==============================================================================

# NODE ENVIRONMENT
NODE_ENV=development
PORT=9000

# ------------------------------------------------------------------------------
# 1. DATABASE & POSTGRESQL (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=san_furniture_dev
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@localhost:5432/san_furniture_dev

# ------------------------------------------------------------------------------
# 2. CACHE & QUEUE (Redis 7 + BullMQ)
# ------------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_PASSWORD=redis_local_secure
REDIS_URL=redis://:redis_local_secure@localhost:6379

# ------------------------------------------------------------------------------
# 3. SEARCH ENGINE (Meilisearch v1.10)
# ------------------------------------------------------------------------------
MEILI_PORT=7700
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=san_meili_master_key_super_secret_2026
NEXT_PUBLIC_MEILI_HOST=http://localhost:7700
NEXT_PUBLIC_MEILI_SEARCH_KEY=san_meili_master_key_super_secret_2026

# ------------------------------------------------------------------------------
# 4. MEDUSA COMMERCE ENGINE & ADMIN
# ------------------------------------------------------------------------------
MEDUSA_BACKEND_URL=http://localhost:9000
JWT_SECRET=super_secret_jwt_key_san_furniture_uk_development_2026
COOKIE_SECRET=super_secret_cookie_key_san_furniture_uk_development_2026
MEDUSA_ADMIN_ONBOARDING_TYPE=default

# ------------------------------------------------------------------------------
# 5. NEXT.JS STOREFRONT
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_DEFAULT_CURRENCY=gbp
NEXT_PUBLIC_DEFAULT_COUNTRY=gb

# ------------------------------------------------------------------------------
# 6. PAYMENTS (Stripe UK & PayPal Business)
# ------------------------------------------------------------------------------
STRIPE_API_KEY=sk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51...

PAYPAL_CLIENT_ID=Ae...
PAYPAL_CLIENT_SECRET=EL...
PAYPAL_MODE=sandbox

# ------------------------------------------------------------------------------
# 7. UK LOGISTICS & POSTCODE LOOKUP
# ------------------------------------------------------------------------------
IDEAL_POSTCODES_API_KEY=ak_test_...
# Alternative: GETADDRESS_API_KEY=...

# ------------------------------------------------------------------------------
# 8. SECURITY & BOT DEFENSE (Cloudflare Turnstile)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA # Cloudflare always-pass test key
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ------------------------------------------------------------------------------
# 9. ASSET STORAGE (Cloudflare R2 / S3-compatible)
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=san-furniture-assets
R2_PUBLIC_URL=https://assets.sanfurniture.com

# ------------------------------------------------------------------------------
# 10. TRANSACTIONAL EMAIL (Resend)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_...
EMAIL_FROM_NAME="SAN Furniture"
EMAIL_FROM_ADDRESS="orders@sanfurniture.com"
