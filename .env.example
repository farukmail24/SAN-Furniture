# ==============================================================================
# SAN Furniture (UK) - Environment Configuration Reference
# ==============================================================================

# Node environment
NODE_ENV=development
PORT=9000

# XAMPP MySQL / MariaDB (create san_furniture in http://localhost/phpmyadmin/)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=san_furniture
DB_USERNAME=root
DB_PASSWORD=

# Cache & queue (Redis 7 + BullMQ)
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-local-redis-password
REDIS_URL=redis://:replace-with-a-local-redis-password@localhost:6379

# Search engine (Meilisearch v1.10)
MEILI_PORT=7700
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=replace-with-a-local-meilisearch-key
NEXT_PUBLIC_MEILI_HOST=http://localhost:7700
NEXT_PUBLIC_MEILI_SEARCH_KEY=replace-with-a-public-search-key

# Backend API
BACKEND_URL=http://localhost:9000
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SECRET=replace-with-a-different-long-random-secret

# Next.js storefront
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:9000
NEXT_PUBLIC_DEFAULT_CURRENCY=gbp
NEXT_PUBLIC_DEFAULT_COUNTRY=gb

# Payments (Stripe UK & PayPal Business)
STRIPE_API_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
PAYPAL_CLIENT_ID=replace_me
PAYPAL_CLIENT_SECRET=replace_me
PAYPAL_MODE=sandbox

# UK logistics & postcode lookup
IDEAL_POSTCODES_API_KEY=replace_me
# Alternative: GETADDRESS_API_KEY=replace_me

# Security & bot defense (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace_me
TURNSTILE_SECRET_KEY=replace_me

# Asset storage (Cloudflare R2 / S3-compatible)
R2_ACCOUNT_ID=replace_me
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_BUCKET_NAME=san-furniture-assets
R2_PUBLIC_URL=https://assets.sanfurniture.com

# Transactional email (Resend)
RESEND_API_KEY=re_replace_me
EMAIL_FROM_NAME="SAN Furniture"
EMAIL_FROM_ADDRESS=orders@sanfurniture.com
