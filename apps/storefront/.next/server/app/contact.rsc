:{"box_title":"UK Delivery & Postcode Estimator","free_threshold_notice":"Free delivery automatically applies on all furniture orders across Mainland UK.","regional_surcharge_notice":"We currently do not deliver outside mainland UK (including Scottish Highlands & Islands, Northern Ireland, Isle of Man, or Channel Islands).","room_of_choice_label":"Delivered directly to your room of choice with packaging removal."}},"pdp_clearance_guide":{"isEnabled":true,"sectionName":"Dimensions & Doorway Clearance Advisory","content":{"guide_title":"Will This Fit In Your Home?","clearance_tips":["Measure all doorway widths, stairwell turns, and hallway clearances before order dispatch.","Check that your ceiling height clears vertical delivery boxes if ordering tall wardrobes.","Our delivery crews can inspect access points upon arrival prior to room positioning."],"helpline_prompt":"Need exact box dimensions? Call our delivery dispatch desk: +44 20 7946 0192."}},"pdp_finance_perks":{"isEnabled":true,"sectionName":"Financing Options (Klarna/Pay in 3) & Payment Badges","content":{"financing_headline":"Spread the cost with 0% APR options","financing_providers":"Klarna • Clearpay","vat_included_notice":"Transparent British Luxury. Zero hidden charges.","security_seal_text":"256-Bit Bank Grade SSL Encrypted Checkout"}},"cart_threshold_banner":{"isEnabled":true,"sectionName":"Free Delivery Progress Bar & Messages","content":{"threshold_amount_gbp":500,"unqualified_message":"Free UK Mainland Delivery on all orders!","qualified_message":"You have unlocked Free UK Room of Choice Delivery!","vat_summary_label":"Inclusive Transparent UK Pricing"}},"cart_trust_guarantees":{"isEnabled":true,"sectionName":"Cart Drawer Trust Badges","content":{"guarantees":["Mainland delivery updates sent via SMS & Email","Free Mainland Delivery within 15 days","Dedicated UK concierge assistance for assembly and care instructions"],"checkout_button_label":"Proceed to Secure UK Checkout"}},"checkout_header_badge":{"isEnabled":true,"sectionName":"Safe & Secure UK Checkout Banner","content":{"banner_title":"Official SAN UK Commerce Gateway","ssl_guarantee":"256-Bit Encrypted • PCI-DSS Level 1 Compliant","vat_invoice_claim":"A transparent digital order confirmation with full itemised breakdown will be sent upon payment confirmation."}},"checkout_delivery_guide":{"isEnabled":true,"sectionName":"Delivery Tiers & Surcharges Guidance","content":{"standard_tier_title":"Standard Tracked Parcel (£9.99 or Free over £100)","pallet_tier_title":"Heavy Goods Pallet Delivery (Free across Mainland UK)","white_glove_title":"Room of Choice Delivery (Free across Mainland UK)","surcharge_disclaimer":"Please note: Orders are currently accepted for Mainland UK addresses only. Deliveries outside Mainland UK are unavailable."}},"about_hero":{"isEnabled":true,"sectionName":"Quality Living & Modern Furniture","content":{"eyebrow":"Our Heritage & Philosophy","title":"Modern Living, Engineered for Everyday Comfort","story":"Founded to deliver thoughtfully designed, high-quality home furniture directly to UK doorsteps without inflated retail markups. From sturdy dining sets to modular storage chests and elegant living furniture, every piece is built for real everyday homes.","highlight_stat_1":"15,000+ Homes Furnished Across the UK","highlight_stat_2":"Rigorous Structural Durability Checks","highlight_stat_3":"100% Quality Inspected Prior to Dispatch"}},"about_sustainability":{"isEnabled":true,"sectionName":"FSC Timber & Ethical Sourcing","content":{"title":"Sustainable Forestry & Responsible Materials","description":"We partner exclusively with certified sawmills across Europe and the UK that practice sustainable forestry under strict FSC and PEFC guidelines. Our foams are non-toxic, and our fabrics are free from hazardous fluorocarbons.","bullet_1":"FSC-Certified Solid European Oak & American Walnut","bullet_2":"Non-toxic high-density reflex foams","bullet_3":"Eco-conscious packaging with cardboard recycling collection"}},"delivery_tiers_guide":{"isEnabled":true,"sectionName":"Delivery Tiers & Service Expectations","content":{"title":"Specialist UK Furniture Logistics","lead_time_summary":"Mainland UK deliveries are typically completed within 7 to 14 business days. Pre-delivery booking calls are made 48 hours prior to dispatch.","tier_1_title":"1. Standard Parcel (Small Items)","tier_1_desc":"Tracked next-day courier delivery for lamps, cushions, stools, and care kits.","tier_2_title":"2. Heavy Goods Pallet Delivery","tier_2_desc":"Kerbside palletized delivery for solid wood dining tables and flatpack modular storage.","tier_3_title":"3. Specialist Room of Choice Service","tier_3_desc":"Delivered into your room of choice, unpackaged, and inspected. Packaging materials are removed for recycling."}},"returns_policy":{"isEnabled":true,"sectionName":"14-Day Returns & Collection Terms","content":{"title":"14-Day Peace of Mind Return Policy","cooling_off_notice":"In full accordance with the UK Consumer Contracts Regulations 2013, you have 14 days from the date of delivery to notify us if you wish to return an item.","collection_procedure":"Contact our Leicester logistics desk, and we will schedule our specialist carrier to collect the piece directly from your home.","condition_requirement":"Items must be returned in resalable condition in original packaging. Refunds are processed within 3-5 business days upon warehouse inspection."}},"contact_details":{"isEnabled":true,"sectionName":"Concierge Contact & Warehouse Address","content":{"page_title":"Customer Concierge & Support Desk","page_subtitle":"Our UK support team is available Monday through Saturday to answer questions regarding orders, product specifications, or room dimensions.","phone":"+44 (0) 20 7946 0192","email":"concierge@sanfurniture.com","whatsapp":"+44 7700 900821","hours":"Monday – Friday: 08:30 – 18:30 GMT | Saturday: 09:00 – 16:00 GMT","warehouse_address":"SAN Furniture Logistics Hub, Unit 4 Meridian Business Park, Leicester LE19 1RJ, United Kingdom"}},"faq_list":{"isEnabled":true,"sectionName":"Frequently Asked Questions","content":{"faqs":[{"question":"How long does UK delivery take?","answer":"Most items are dispatched directly from our UK supplier warehouses within 3-5 business days and delivered within 7-14 business days. You will receive an SMS and tracking code to select your delivery window."},{"question":"How is my furniture packaged and delivered?","answer":"Every piece is carefully boxed in reinforced flat-pack protective packaging with corner buffers, and dispatched directly across Mainland UK within 10-15 business days."},{"question":"What delivery service is provided?","answer":"We provide free delivery across Mainland UK directly to your doorstep with pre-delivery dispatch updates."},{"question":"Will I receive an itemised order receipt?","answer":"Yes, an official itemised digital order receipt with complete product codes, quantities, and order reference will be emailed upon payment confirmation."}]}},"account_welcome_banner":{"isEnabled":true,"sectionName":"Client Portal Banner & Privileges","content":{"welcome_title":"SAN Client Portal","welcome_subtitle":"Manage your active furniture orders, download official order receipts, review assembly guides, and track mainland dispatches.","vip_perk_badge":"UK Verified Client","support_shortcut_text":"Need urgent delivery rescheduling? Speak to dispatch directly via our live helpdesk."}}},"initialProducts":[],"children":"$L26"}]}]}]
