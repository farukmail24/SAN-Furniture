4ba6bd?q=80&w=800&auto=format&fit=crop","href":"/office?type=desks"}},{"id":"bathroom","label":"Bathroom","href":"/bathroom","badge":"","columns":[{"title":"Vanity & Basin Units","links":[{"label":"All Bathroom Furniture","href":"/bathroom"},{"label":"Bathroom Vanity Sink Units","href":"/bathroom?type=vanity-units","badge":"POPULAR"},{"label":"Undersink Storage Cupboards","href":"/bathroom?type=undersink-cabinets"},{"label":"Countertop Basin Cabinets","href":"/bathroom?type=countertop-basins"},{"label":"Floor Standing Vanity Units","href":"/bathroom?type=freestanding-vanity"}]},{"title":"Bathroom Storage","links":[{"label":"Tall Narrow Cupboards","href":"/bathroom?type=tall-cabinets","badge":"BESTSELLER"},{"label":"Wall Hanging Cabinets","href":"/bathroom?type=wall-cabinets"},{"label":"Mirrored Bathroom Cabinets","href":"/bathroom?type=mirror-cabinets"},{"label":"Freestanding Linen Cupboards","href":"/bathroom?type=bathroom-storage"},{"label":"Bathroom Storage Shelves","href":"/bathroom?type=bathroom-shelves"}]},{"title":"Finishes & Craftsmanship","links":[{"label":"Alpine High-Gloss White","href":"/bathroom?finish=gloss-white"},{"label":"Natural Moisture-Resistant Oak","href":"/bathroom?material=oak"},{"label":"Anthracite & Matte Grey","href":"/bathroom?finish=grey"},{"label":"Compact En-Suite Solutions","href":"/bathroom?size=compact"},{"label":"Soft-Close Premium Ranges","href":"/bathroom?feature=soft-close"}]}],"featured_promo":{"badge":"MOISTURE RESISTANT","title":"Milano Tall Narrow Cupboard","subtitle":"Space-saving high-gloss finish with reversible doors and internal shelving.","image_url":"https://images.unsplash.com/photo-1584622650111-993a426fbf0a?auto=format&fit=crop&w=800&q=80","cta_label":"Explore Bathroom","cta_href":"/bathroom"},"featured_product":{"tag":"High Gloss","title":"Milano Tall Bathroom Cupboard","price_str":"£159.10","image_url":"https://images.unsplash.com/photo-1584622650111-993a426fbf0a?auto=format&fit=crop&w=800&q=80","href":"/bathroom"}},{"id":"sale","label":"Sale","href":"/sale","badge":"SALE","columns":[{"title":"Clearance By Room","links":[{"label":"All Sale & Clearance","href":"/sale"},{"label":"Living Room Clearance","href":"/sale?category=living-room"},{"label":"Bedroom & Bedding Savings","href":"/sale?category=bedroom"},{"label":"Dining Suites on Offer","href":"/sale?category=dining"},{"label":"Sofa & Lounge Discounts","href":"/sale?category=sofas"},{"label":"Office & Workstation Deals","href":"/sale?category=office"}]},{"title":"Special Savings","links":[{"label":"Showroom Clearance Lines","href":"/sale?discount=40","badge":"UP TO 40% OFF"},{"label":"Bedside Table Value Multi-Packs","href":"/bedroom?type=bedside-tables"},{"label":"Dining Suite Complete Packages","href":"/dining?type=dining-sets"},{"label":"Trade & Bulk Purchase Discounts","href":"/contact?inquiry=trade"}]},{"title":"Shop By Discount","links":[{"label":"Up to 20% Off Selection","href":"/sale?discount=20"},{"label":"Up to 30% Off Bestsellers","href":"/sale?discount=30"},{"label":"Up to 40% Off Clearance","href":"/sale?discount=40","badge":"POPULAR"},{"label":"Up to 50% Off Half Price","href":"/sale?discount=50","badge":"HALF PRICE"},{"label":"Deals Under £150","href":"/sale?max_price=150"},{"label":"Last Chance Clearance","href":"/sale?tag=last-chance","badge":"FINAL STOCK"}]}],"featured_promo":{"badge":"SPECIAL SAVINGS","title":"Seasonal Direct Clearance","subtitle":"Direct UK mainland dispatch on contemporary home furniture.","image_url":"https://images.unsplash.com/photo-1532372320572-cda25653a26d?q=80&w=800&auto=format&fit=crop","cta_label":"Shop All Special Offers","cta_href":"/sale"},"featured_product":{"tag":"Clearance Deal","title":"Venice Alpine White Bedside","price_str":"£110.46","original_price_str":"£145.00","image_url":"https://images.unsplash.com/photo-1532372320572-cda25653a26d?q=80&w=800&auto=format&fit=crop","href":"/products/venice-alpine-white-bedside"}}],"bottom_perks":[{"icon":"Truck","text":"Free Delivery Across Mainland UK on All Orders"},{"icon":"ShieldCheck","text":"UK Quality Checked & Durability Tested"},{"icon":"CreditCard","text":"Zero Hidden Fees & Secure Card Checkout"}]}},"home_newsletter":{"isEnabled":true,"sectionName":"VIP Newsletter & Private Sales","content":{"eyebrow":"The SAN Private Circle","title":"Receive £50 Off Your First Order Over £500","subtitle":"Join our UK private collectors list for early access to limited edition drops, seasonal showroom previews, and interior design curations.","placeholder":"Enter your personal email address...","button_text":"Claim Voucher","disclaimer":"No spam. Unsubscribe at any time. Strictly adhering to UK GDPR 2018."}},"pdp_value_badges":{"isEnabled":true,"sectionName":"Guarantees & Reassurance Badges","content":{"badges":[{"icon":"Truck","title":"Free Mainland Delivery","subtitle":"Direct to your door within 15 days across Mainland UK","description":"Direct to your door within 15 days across Mainland UK"},{"icon":"ShieldCheck","title":"UK Quality Checked","subtitle":"Rigorous structural durability & quality inspection","description":"Rigorous structural durability & quality inspection"},{"icon":"CreditCard","title":"Secure Card Checkout","subtitle":"256-bit encrypted checkout via Stripe UK","description":"256-bit encrypted checkout via Stripe UK"}]}},"pdp_delivery_info":{"isEnabled":true,"sectionName":"Delivery Tiers & Postcode Checker Info","content":{"box_title":"UK Delivery & Postcode Estimator","free_threshold_notice":"Free delivery automatically applies on all furniture orders across Mainland UK.","regional_surcharge_notice":"We currently do not deliver outside mainland UK (including Scottish Highlands & Islands, Northern Ireland, Isle of Man, or Channel Islands).","room_of_choice_label":"Delivered directly to your room of choice with packaging removal."}},"pdp_clearance_guide":{"isEnabled":true,"sectionName":"Dimensions & Doorway Clearance Advisory","content":{"guide_title":"Will This Fit In Your Home?","clearance_tips":["Measure all doorway widths, stairwell turns, and hallway clearances before order dispatch.","Check that your ceiling height clears vertical delivery boxes if ordering tall wardrobes.","Our delivery crews can inspect access points upon arrival prior to room positioning."],"helpline_prompt":"Need exact box dimensions? Call our delivery dispatch desk: +44 20 7946 0192."}},"pdp_finance_perks":{"isEnabled":true,"sectionName":"Financing Options (Klarna/Pay in 3) & Payment Badges","content":{"financing_headline":"Spread the cost with 0% APR options","financing_providers":"Klarna • Clearpay","vat_included_notice":"Transparent British Luxury. Zero hidden charges.","security_seal_text":"256-Bit Bank Grade SSL Encrypted Checkout"}},"cart_threshold_banner":{"isEnabled":true,"sectionName":"Free Delivery Progress Bar & Messages","content":{"threshold_amount_gbp":500,"unqualified_message":"Free UK Mainland Delivery on all orders!","qualified_message":"You have unlocked Free UK Room of Choice Delivery!","vat_summary_label":"Inclusive Transparent UK Pricing"}},"cart_trust_guarantees":{"isEnabled":true,"sectionName":"Cart Drawer Trust Badges","content":{"guarantees":["Mainland delivery updates sent via SMS & Email","Free Mainland Delivery within 15 days","Dedicated UK concierge assistance for assembly and care instructions"],"checkout_button_label":"Proceed to Secure UK Checkout"}},"checkout_header_badge":{"isEnabled":true,"sectionName":"Safe & Secure UK Checkout Banner","content":{"banner_title":"Official SAN UK Commerce Gateway","ssl_guarantee":"256-Bit Encrypted • PCI-DSS Level 1 Compliant","vat_invoice_claim":"A transparent digital order confirmation with full itemised breakdown will be sent upon payment confirmation."}},"checkout_delivery_guide":{"isEnabled":true,"sectionName":"Delivery Tiers & Surcharges Guidance","content":{"standard_tier_title":"Standard Tracked Parcel (£9.99 or Free over £100)","pallet_tier_title":"Heavy Goods Pallet Delivery (Free across Mainland UK)","white_glove_title":"Room of Choice Delivery (Free across Mainland UK)","surcharge_disclaimer":"Please note: Orders are currently accepted for Mainland UK addresses only. Deliveries outside Mainland UK are unavailable."}},"about_hero":{"isEnabled":true,"sectionName":"Quality Living & Modern Furniture","content":{"eyebrow":"Our Heritage & Philosophy","title":"Modern Living, Engineered for Everyday Comfort","story":"Founded to deliver thoughtfully designed, high-quality home furniture directly to UK doorsteps without inflated retail markups. From sturdy dining sets to modular storage chests and elegant living furniture, every piece is built for real everyday homes.","highlight_stat_1":"15,000+ Homes Furnished Across the UK","highlight_stat_2":"Rigorous Structural Durability Checks","highlight_stat_3":"100% Quality Inspected Prior to Dispatch"}},"about_sustainability":{"isEnabled":true,"sectionName":"FSC Timber & Ethical Sourcing","content":{"title":"Sustainable Forestry & Responsible Materials","description":"We partner exclusively with certified sawmills across Europe and the UK that practice sustainable forestry under strict FSC and PEFC guidelines. Our foams are non-toxic, and our fabrics are free from hazardous fluorocarbons.","bullet_1":"FSC-Certified Solid European Oak & American Walnut","bullet_2":"Non-toxic high-density reflex foams","bullet_3":"Eco-conscious packaging with cardboard recycling collection"}},"delivery_tiers_guide":{"isEnabled":true,"sectionName":"Delivery Tiers & Service Expectations","content":{"title":"Specialist UK Furniture Logistics","lead_time_summary":"Mainland UK deliveries are typically completed within 7 to 14 business days. Pre-delivery booking calls are made 48 hours prior to dispatch.","tier_1_title":"1. Standard Parcel (Small Items)","tier_1_desc":"Tracked next-day courier delivery for lamps, cushions, stools, and care kits.","tier_2_title":"2. Heavy Goods Pallet Delivery","tier_2_desc":"Kerbside palletized delivery for solid wood dining tables and flatpack modular storage.","tier_3_title":"3. Specialist Room of Choice Service","tier_3_desc":"Delivered into your room of choice, unpackaged, and inspected. Packaging materials are removed for recycling."}},"returns_policy":{"isEnabled":true,"sectionName":"14-Day Returns & Collection Terms","content":{"title":"14-Day Peace of Mind Return Policy","cooling_off_notice":"In full accordance with the UK Consumer Contracts Regulations 2013, you have 14 days from the date of delivery to notify us if you wish to return an item.","collection_procedure":"Contact our Leicester logistics desk, and we will schedule our specialist carrier to collect the piece directly from your home.","condition_requirement":"Items must be returned in resalable condition in original packaging. Refunds are processed within 3-5 business days upon warehouse inspection."}},"contact_details":{"isEnabled":true,"sectionName":"Concierge Contact & Support Desk","content":{"page_title":"Customer Concierge & Support Desk","page_subtitle":"Our UK support team is available Monday through Saturday to answer questions regarding orders, product specifications, or room dimensions.","phone":"+4420 3150 3472","email":"support@sanfurniture.com","whatsapp":"+4420 3150 3472","hours":"Monday – Friday: 08:30 – 18:30 GMT | Saturday: 09:00 – 16:00 GMT","registered_office":"112 Coventry Road, Exhall, Coventry, CV7 9EU, United Kingdom"}},"faq_list":{"isEnabled":true,"sectionName":"Frequently Asked Questions","content":{"faqs":[{"question":"How long does UK delivery take?","answer":"Most items are dispatched directly from our UK supplier warehouses within 3-5 business days and delivered within 7-14 business days. You will receive an SMS and tracking code to select your delivery window."},{"question":"How is my furniture packaged and delivered?","answer":"Every piece is carefully boxed in reinforced flat-pack protective packaging with corner buffers, and dispatched directly across Mainland UK within 10-15 business days."},{"question":"What delivery service is provided?","answer":"We provide free delivery across Mainland UK directly to your doorstep with pre-delivery dispatch updates."},{"question":"Will I receive an itemised order receipt?","answer":"Yes, an official itemised digital order receipt with complete product codes, quantities, and order reference will be emailed upon payment confirmation."}]}},"account_welcome_banner":{"isEnabled":true,"sectionName":"Client Portal Banner & Privileges","content":{"welcome_title":"SAN Client Portal","welcome_subtitle":"Manage your active furniture orders, download official order receipts, review assembly guides, and track mainland dispatches.","vip_perk_badge":"UK Verified Client","support_shortcut_text":"Need urgent delivery rescheduling? Speak to dispatch directly via our live helpdesk."}},"legal_terms":{"isEnabled":true,"sectionName":"Terms and Conditions (/terms)","content":{"page_badge":"SAN Furniture Limited • Company No. 11733475","page_title":"SAN Furniture Limited — Terms and Conditions","page_subtitle":"Registered office: 112 Coventry Road, Exhall, West Midlands, CV7 9EU • Registered in England and Wales.","notice_title":"Important Notice","notice_body":"Please read all these Terms and Conditions. As we can accept your order and make a legally enforceable agreement without further reference to you, you must read these Terms and Conditions to make sure that they contain all that you want and nothing that you are not happy with. If you are not sure about anything, just phone us on +4420 3150 3472.","sections":[{"id":"application","title":"Application","body":"1. These Terms and Conditions will apply to the purchase of the goods by you (the Customer or you). We are SAN Furniture Limited a company registered in England and Wales under number 11733475 whose registered office is at 112 Coventry Road, Exhall, West Midlands, CV7 9EU with email address privacy@sanfurniture.com; telephone number +4420 3150 3472; (the Supplier or us or we).\n\n2. These are the terms on which we sell all Goods to you. By ordering any of the Goods, you agree to be bound by these Terms and Conditions. Before placing an order on the Website, you will be asked to agree to these Terms and Conditions by clicking on the button marked 'I Accept'. If you do not click on the button, you will not be able to complete your Order. You can only purchase the Goods from the Website if you are eligible to enter into a contract and are at least 18 years old."},{"id":"interpretation","title":"Interpretation","body":"$26"},{"id":"goods","title":"Goods","body":"1. The description of the Goods is as set out in the Website, catalogues, brochures or other form of advertisement. Any description is for illustrative purposes only and there may be small discrepancies in the size and colour of the Goods supplied.\n\n2. In the case of any Goods made to your special requirements, it is your responsibility to ensure that any information or specification you provide is accurate.\n\n3. All Goods which appear on the Website are subject to availability.\n\n4. We can make changes to the Goods which are necessary to comply with any applicable law or safety requirement. We will notify you of these changes."},{"id":"personal-information","title":"Personal Information and Registration","body":"1. When registering to use the Website you must set up a username and password. You remain responsible for all actions taken under the chosen username and password and undertake not to disclose your username and password to anyone else and keep them secret.\n\n2. We retain and use all information strictly under the Privacy Policy.\n\n3. We may contact you by using e-mail or other electronic communication methods and by pre-paid post and you expressly agree to this."},{"id":"basis-of-sale","title":"Basis of Sale","body":"$27"},{"id":"price-and-payment","title":"Price and Payment","body":"1. The price of the Goods and any additional delivery or other charges is that set out on the Website at the date of the Order or such other price as we may agree in writing.\n\n2. Prices and charges include VAT at the rate applicable at the time of the Order.\n\n3. You must pay by submitting your credit or debit card details with your Order and we can take payment immediately or otherwise before delivery of the Goods."},{"id":"delivery","title":"Delivery","body":"$28"},{"id":"risk-and-title","title":"Risk and Title","body":"1. Risk of damage to, or loss of, any Goods will pass to you when the Goods are delivered to you.\n\n2. You do not own the Goods until we have received payment in full. If full payment is overdue or a step occurs towards your bankruptcy, we can choose, by notice to cancel any delivery and end any right to use the Goods still owned by you, in which case you must return them or allow us to collect them."},{"id":"withdrawal-returns","title":"Withdrawal, Returns and Cancellation","body":"1. You can withdraw the Order by telling us before the Contract is made, if you simply wish to change your mind and without giving us a reason, and without incurring any liability.\n\n2. This is a distance contract (as defined below) which has the cancellation rights (Cancellation Rights) set out below. These Cancellation Rights, however, do not apply, to a contract for the following goods (with no others) in the following circumstances:\n\n2.1 foodstuffs, beverages or other goods intended for current consumption in the household and which are supplied on frequent and regular rounds to your residence or workplace;\n\n2.2 goods that are made to your specifications or are clearly personalised;\n\n2.3 goods which are liable to deteriorate or expire rapidly.\n\n3. Also, the Cancellation Rights for a Contract cease to be available in the following circumstances:\n\n3.1 in the case of any sales contract, if the goods become mixed inseparably (according to their nature) with other items after delivery."},{"id":"right-to-cancel","title":"Right to Cancel","body":"$29"},{"id":"effects-of-cancellation","title":"Effects of Cancellation in the Cancellation Period","body":"1. Except as set out below, if you cancel this Contract, we will reimburse to you all payments received from you, including the costs of delivery (except for the supplementary costs arising if you chose a type of delivery other than the least expensive type of standard delivery offered by us)."},{"id":"deduction-for-goods","title":"Deduction for Goods Supplied","body":"1. We may make a deduction from the reimbursement for loss in value of any Goods supplied, if the loss is the result of unnecessary handling by you (ie handling the Goods beyond what is necessary to establish the nature, characteristics and functioning of the Goods: eg it goes beyond the sort of handling that might be reasonably allowed in a shop). This is because you are liable for that loss and, if that deduction is not made, you must pay us the amount of that loss."},{"id":"timing-of-reimbursement","title":"Timing of Reimbursement","body":"1. If we have not offered to collect the Goods, we will make the reimbursement without undue delay, and not later than:\n\n1.1 14 days after the day we receive back from you any Goods supplied, or\n\n1.2 (if earlier) 14 days after the day you provide evidence that you have sent back the Goods.\n\n2. If we have offered to collect the Goods or if no Goods were supplied, we will make the reimbursement without undue delay, and not later than 14 days after the day on which we are informed about your decision to cancel this Contract.\n\n3. We will make the reimbursement using the same means of payment as you used for the initial transaction, unless you have expressly agreed otherwise; in any event, you will not incur any fees as a result of the reimbursement."},{"id":"returning-goods","title":"Returning Goods","body":"$2a"},{"id":"conformity","title":"Conformity","body":"1. We have a legal duty to supply the Goods in conformity with the Contract, and will not have conformed if it does not meet the following obligation.\n\n2. Upon delivery, the Goods will:\n\n2.1 be of satisfactory quality;\n\n2.2 be reasonably fit for any particular purpose for which you buy the Goods which, before the Contract is made, you made known to us (unless you do not actually rely, or it is unreasonable for you to rely, on our skill and judgment) and be fit for any purpose held out by us or set out in the Contract; and\n\n2.3 conform to their description.\n\n3. It is not a failure to conform if the failure has its origin in your materials."},{"id":"successors-subcontractors","title":"Successors and Our Sub-Contractors","body":"1. Either party can transfer the benefit of this Contract to someone else, and will remain liable to the other for its obligations under the Contract. The Supplier will be liable for the acts of any sub-contractors who it chooses to help perform its duties."},{"id":"circumstances-beyond-control","title":"Circumstances Beyond the Control of Either Party","body":"1. In the event of any failure by a party because of something beyond its reasonable control:\n\n1.1 the party will advise the other party as soon as reasonably practicable; and\n\n1.2 the party's obligations will be suspended so far as is reasonable, provided that that party will act reasonably, and the party will not be liable for any failure which it could not reasonably avoid, but this will not affect the Customer's above rights relating to delivery and any right to cancel, below."},{"id":"privacy","title":"Privacy","body":"$2b"},{"id":"excluding-liability","title":"Excluding Liability","body":"1. The Supplier does not exclude liability for: (i) any fraudulent act or omission; or (ii) for death or personal injury caused by negligence or breach of the Supplier's other legal obligations. Subject to this, the Supplier is not liable for (i) loss which was not reasonably foreseeable to both parties at the time when the Contract was made, or (ii) loss (eg loss of profit) to the Customer's business, trade, craft or profession which would not be suffered by a Consumer - because the Supplier believes the Customer is not buying the Goods wholly or mainly for its business, trade, craft or profession."},{"id":"governing-law","title":"Governing Law, Jurisdiction and Complaints","body":"1. The Contract (including any non-contractual matters) is governed by the law of England and Wales.\n\n2. Disputes can be submitted to the jurisdiction of the courts of England and Wales or, where the Customer lives in Scotland or Northern Ireland, in the courts of respectively Scotland or Northern Ireland.\n\n3. We try to avoid any dispute, so we deal with complaints in the following way: If a dispute occurs customers should contact us to find a solution. We will aim to respond with an appropriate solution within 5 days."}]}},"legal_privacy":{"isEnabled":true,"sectionName":"Privacy Policy & Cookies Schedule (/privacy)","content":{"page_badge":"SAN Furniture Limited • UK GDPR & Cookie Law","page_title":"SAN Furniture Limited — Privacy Policy","page_subtitle":"Registered office: 112 Coventry Road, Exhall, West Midlands, CV7 9EU • Data Protection & Cookies Policy.","notice_title":"Privacy Notice","notice_body":"This Privacy Policy applies between you, the User of this Website, and SAN Furniture Limited, the owner and provider of this Website. SAN Furniture Limited takes the privacy of your information very seriously. This Privacy Policy applies to our use of any and all Data collected by us or provided by you in relation to your use of the Website. This Privacy Policy should be read alongside, and in addition to, our Terms and Conditions, which can be found at: https://www.sanfurniture.com/terms. Please read this Privacy Policy carefully.","sections":[{"id":"definitions","title":"Definitions and Interpretation","body":"$2c"},{"id":"scope","title":"Scope of this Privacy Policy","body":"3. This Privacy Policy applies only to the actions of SAN Furniture Limited and Users with respect to this Website. It does not extend to any websites that can be accessed from this Website, including, but not limited to, any links we may provide to social media websites.\n\n4. For purposes of the applicable Data Protection Laws, SAN Furniture Limited is the \"data controller\". This means that SAN Furniture Limited determines the purposes for which, and the manner in which, your Data is processed."},{"id":"data-collected","title":"Data Collected","body":"5. We may collect the following Data, which includes personal Data, from you:\n\na. name;\n\nb. contact Information such as email addresses and telephone numbers;\n\nc. financial information such as credit / debit card numbers;\n\nin each case, in accordance with this Privacy Policy."},{"id":"how-we-collect-data","title":"How We Collect Data","body":"6. We collect Data in the following ways:\n\na. data is given to us by you; and\n\nb. data is collected automatically."},{"id":"data-given-by-you","title":"Data That is Given to Us by You","body":"7. SAN Furniture Limited will collect your Data in a number of ways, for example:\n\na. when you contact us through the Website, by telephone, post, e-mail or through any other means;\n\nb. when you register with us and set up an account to receive our products/services;\n\nc. when you make payments to us, through this Website or otherwise;\n\nin each case, in accordance with this Privacy Policy."},{"id":"data-collected-automatically","title":"Data That is Collected Automatically","body":"8. To the extent that you access the Website, we will collect your Data automatically, for example:\n\na. we automatically collect some information about your visit to the Website. This information helps us to make improvements to Website content and navigation, and includes your IP address, the date, times and frequency with which you access the Website and the way you use and interact with its content.\n\nb. we will collect your Data automatically via cookies, in line with the cookie settings on your browser. For more information about cookies, and how we use them on the Website, see the section below, headed \"Cookies\"."},{"id":"our-use-of-data","title":"Our Use of Data","body":"$2d"},{"id":"who-we-share-data-with","title":"Who We Share Data With","body":"13. We may share your Data with the following groups of people for the following reasons:\n\na. any of our group companies or affiliates - to ensure the proper administration of your website and business;\n\nb. our employees, agents and/or professional advisors - to obtain advice from professional advisers;\n\nc. relevant authorities - to facilitate the detection of crime or the collection of taxes or duties;\n\nin each case, in accordance with this Privacy Policy."},{"id":"keeping-data-secure","title":"Keeping Data Secure","body":"14. We will use technical and organisational measures to safeguard your Data, for example:\n\na. access to your account is controlled by a password and a user name that is unique to you.\n\nb. we store your Data on secure servers.\n\nc. payment details are encrypted using SSL technology (typically you will see a lock icon or green address bar (or both) in your browser when we use this technology).\n\n15. Technical and organisational measures include measures to deal with any suspected data breach. If you suspect any misuse or loss or unauthorised access to your Data, please let us know immediately by contacting us via this e-mail address: privacy@sanfurniture.com.\n\n16. If you want detailed information from Get Safe Online on how to protect your information and your computers and devices against fraud, identity theft, viruses and many other online problems, please visit www.getsafeonline.org. Get Safe Online is supported by HM Government and leading businesses."},{"id":"data-retention","title":"Data Retention","body":"17. Unless a longer retention period is required or permitted by law, we will only hold your Data on our systems for the period necessary to fulfil the purposes outlined in this Privacy Policy or until you request that the Data be deleted.\n\n18. Even if we delete your Data, it may persist on backup or archival media for legal, tax or regulatory purposes."},{"id":"your-rights","title":"Your Rights","body":"$2e"},{"id":"links-to-other-websites","title":"Links to Other Websites","body":"23. This Website may, from time to time, provide links to other websites. We have no control over such websites and are not responsible for the content of these websites. This Privacy Policy does not extend to your use of such websites. You are advised to read the Privacy Policy or statement of other websites prior to using them."},{"id":"business-ownership","title":"Changes of Business Ownership and Control","body":"24. SAN Furniture Limited may, from time to time, expand or reduce our business and this may involve the sale and/or the transfer of control of all or part of SAN Furniture Limited. Data provided by Users will, where it is relevant to any part of our business so transferred, be transferred along with that part and the new owner or newly controlling party will, under the terms of this Privacy Policy, be permitted to use the Data for the purposes for which it was originally supplied to us.\n\n25. We may also disclose Data to a prospective purchaser of our business or any part of it.\n\n26. In the above instances, we will take steps with the aim of ensuring your privacy is protected."},{"id":"cookies","title":"Cookies","body":"$2f"},{"id":"general","title":"General","body":"37. You may not transfer any of your rights under this Privacy Policy to any other person. We may transfer our rights under this Privacy Policy where we reasonably believe your rights will not be affected.\n\n38. If any court or competent authority finds that any provision of this Privacy Policy (or part of any provision) is invalid, illegal or unenforceable, that provision or part-provision will, to the extent required, be deemed to be deleted, and the validity and enforceability of the other provisions of this Privacy Policy will not be affected.\n\n39. Unless otherwise agreed, no delay, act or omission by a party in exercising any right or remedy will be deemed a waiver of that, or any other, right or remedy.\n\n40. This Agreement will be governed by and interpreted according to the law of England and Wales. All disputes arising under the Agreement will be subject to the exclusive jurisdiction of the English and Welsh courts."},{"id":"changes-to-policy","title":"Changes to This Privacy Policy","body":"41. SAN Furniture Limited reserves the right to change this Privacy Policy as we may deem necessary from time to time or as may be required by law. Any changes will be immediately posted on the Website and you are deemed to have accepted the terms of the Privacy Policy on your first use of the Website following the alterations.\n\n42. You may contact SAN Furniture Limited by email at privacy@sanfurniture.com."},{"id":"cookies-schedule","title":"Cookies Schedule","body":"Below is a list of the cookies that we use. We have tried to ensure this is complete and up to date, but if you think that we have missed a cookie or there is any discrepancy, please let us know.\n\n### Strictly necessary\nWe use the following strictly necessary cookies:\n| Description | Purpose |\n| We use this session cookie to remember you and maintain your session whilst you are using our website. | — |\n\n### Functionality\nWe use the following functionality cookies:\n| Description | Purpose |\n| We use this cookie to identify your computer and analyse traffic patterns on our website. | — |\n\n### Analytical/Performance\nWe use the following analytical/performance cookies:\n| Description | Purpose |\n| We use this cookie to help us analyse how users use the website. | — |"}]}}},"initialProducts":[],"children":"$L30"}]}]}]
