# ==============================================================================
# SAN Furniture Storefront Environment Configuration
# ==============================================================================
#
# 1. Local Development (Default):
#    NEXT_PUBLIC_API_URL=http://localhost:9000
#
# 2. cPanel / Shared Hosting / VPS (Same-Domain Reverse Proxy / Subpath):
#    If Next.js is configured to proxy /api directly through next.config.ts rewrites,
#    you can leave NEXT_PUBLIC_API_URL empty or unset:
#    NEXT_PUBLIC_API_URL=
#
# 3. Dedicated Backend Domain / Subdomain:
#    If the backend is running on a subdomain or separate server:
#    NEXT_PUBLIC_API_URL=https://api.sanfurniture.co.uk
#
# 4. Internal Docker Network / SSR (Optional):
#    BACKEND_INTERNAL_URL=http://backend:9000

NEXT_PUBLIC_API_URL=http://localhost:9000

