{
  "name": "san-furniture",
  "version": "1.0.0",
  "private": true,
  "description": "Ultra-premium UK dropshipping furniture platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"backend,storefront\" -c \"bgBlue.bold,bgGreen.bold\" \"npm run dev:backend\" \"npm run dev:storefront\"",
    "start": "concurrently -n \"backend,storefront\" -c \"bgBlue.bold,bgGreen.bold\" \"npm run start:backend\" \"npm run start:storefront\"",
    "dev:backend": "npm run --workspace=backend dev",
    "dev:storefront": "npm run --workspace=storefront dev",
    "start:backend": "npm run --workspace=backend start",
    "start:storefront": "npm run --workspace=storefront start",
    "db:seed": "node scripts/generate-and-seed-mysql.mjs",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "lint": "npm run --workspaces --if-present lint",
    "test": "npm run --workspaces --if-present test",
    "build": "npm run --workspaces --if-present build"
  },
  "overrides": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "keywords": [
    "furniture",
    "dropshipping",
    "uk-ecommerce",
    "nextjs",
    "medusa"
  ],
  "author": "SAN Furniture Engineering Team",
  "license": "UNLICENSED",
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "ts-node": "^10.9.2"
  }
}
